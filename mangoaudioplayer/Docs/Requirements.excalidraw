      "seed": 109002863,
      "version": 351,
      "versionNonce": 1786107119,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791789402229,
      "created": 1791789111319,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements:\n- Offline support audio for better audio streaming\n- Optimize for low network & battery using chunk streaming\n- Support 1000 audios.\n- Data usage: auto downscale bitrate when on low/cellular bandwidth",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements:\n- Offline support audio for better audio streaming\n- Optimize for low network & battery using chunk streaming\n- Support 1000 audios.\n- Data usage: auto downscale bitrate when on low/cellular bandwidth",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
