      "updated": 1791788189007,
      "created": 1791788076557,
      "link": null,
      "locked": false,
      "text": "Data Model: \n- AudioTrack\n  - id: UUID\n  - name: String\n  - author: String\n  - thumbnail_url: String\n  - created_at: Date\n  \n- AudioLyric:\n  - id: UUID\n  - track_id: UUID\n  - content\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data Model: \n- AudioTrack\n  - id: UUID\n  - name: String\n  - author: String\n  - thumbnail_url: String\n  - created_at: Date\n  \n- AudioLyric:\n  - id: UUID\n  - track_id: UUID\n  - content\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
