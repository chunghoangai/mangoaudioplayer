    {
      "id": "vNQmdBK_DnB7Zd0mTIYHl",
      "type": "text",
      "x": 258.92291259765625,
      "y": 334.09657287597656,
      "width": 800,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g2nFxAx27YTMz-KVvPfhw"
      ],
      "frameId": null,
      "index": "b1K",
      "roundness": null,
      "seed": 1436899599,
      "version": 678,
      "versionNonce": 1810059439,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791789195854,
      "created": 1791787376540,
      "link": null,
      "locked": false,
      "text": "- Support fetch audios list from server\n- Allow to sorts using the created_at, name\n- Support fetch thumbnail, audio information. Control playback like seek, pause,\nspeed.\n- Support fetch the lyrics and display it. not support scrolling to current playing\nposition\n- Support cache the audio, change the quality.\n- Support small items about 1000 audio server\n- Not talk about the user yet\n- Assume that the auth work well.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Support fetch audios list from server\n- Allow to sorts using the created_at, name\n- Support fetch thumbnail, audio information. Control playback like seek, pause, speed.\n- Support fetch the lyrics and display it. not support scrolling to current playing position\n- Support cache the audio, change the quality.\n- Support small items about 1000 audio server\n- Not talk about the user yet\n- Assume that the auth work well.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "BXjG61Wtx1UBylMiWKZ4g",
      "type": "text",
      "x": 899.414306640625,
      "y": 1018.1759338378906,
      "width": 640.4199829101562,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1N",
      "roundness": null,
      "seed": 66229135,
      "version": 487,
      "versionNonce": 1833238977,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791788302897,
      "created": 1791787526916,
      "link": null,
      "locked": false,
      "text": "APIs:\n- GET: audio/v1/all?sort={}&limit={}&offset={}\n- GET: audio/v1/{id}/metadata this one include the thumbnail url\n- GET: audio/v1/{id}/lyrics\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs:\n- GET: audio/v1/all?sort={}&limit={}&offset={}\n- GET: audio/v1/{id}/metadata this one include the thumbnail url\n- GET: audio/v1/{id}/lyrics\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "HChA90-8CtO2Br32hBq-2",
      "type": "text",
      "x": 228.77142333984375,
      "y": 1020.4837646484375,
      "width": 230.38003540039062,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
