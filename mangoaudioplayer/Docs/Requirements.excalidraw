    {
      "id": "OvrfnNk4PfaCq11tvFRc8",
      "type": "text",
      "x": 239.85711669921875,
      "y": 627.0227661132812,
      "width": 800,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b26",
      "roundness": null,
      "seed": 2130979873,
      "version": 363,
      "versionNonce": 1009775617,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791789283363,
      "created": 1791789031122,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n- fetch and show the audio list\n- Sort the audio using created_at, name\n- Support control play back\n- offline support audio\n- Support fetch and display the audio lyrics without seek \nfor the current position\n- not support auth, assume it work well\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n- fetch and show the audio list\n- Sort the audio using created_at, name\n- Support control play back\n- offline support audio\n- Support fetch and display the audio lyrics without seek \nfor the current position\n- not support auth, assume it work well\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WfnjabtHTkVr_duWk5uB7",
      "type": "text",
      "x": 935,
      "y": 626.842529296875,
      "width": 672.9799194335938,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b29",
